# Never run install-time scripts from dependencies. Nothing in this project
# needs them (esbuild, rollup and sharp ship prebuilt binaries as optional
# packages), and they are the usual way a compromised package runs code on a
# developer machine, in CI or on the server build. `npm run <script>` still
# works as normal.
ignore-scripts=true
# Fail fast if the lockfile and package.json disagree.
package-lock=true
